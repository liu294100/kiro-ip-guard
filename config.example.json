{
  "config_version": 2,
  "enabled": true,
  "policy_mode": "combined",
  "ip_query_network_mode": "auto",
  "language": "auto",
  "check_updates": true,
  "check_interval_seconds": 1,
  "cache_ttl_seconds": 600,
  "request_timeout_seconds": 8,
  "allowed_country_codes": [
    "US"
  ],
  "blocked_country_codes": [
    "CN",
    "CU",
    "HK",
    "IR",
    "KP",
    "MO",
    "RU",
    "SY"
  ],
  "blocked_ip_networks": [],
  "process_names": [
    "kiro",
    "kiro.exe",
    "kiro-cli",
    "kiro-cli.exe"
  ],
  "fail_closed": false,
  "clash_required": true,
  "clash_process_names": [
    "clash",
    "clash.exe",
    "clash-win64.exe",
    "clash-meta.exe",
    "clash-verge.exe",
    "clash-verge-rev.exe",
    "clash-verge-service.exe",
    "clash-nyanpasu.exe",
    "mihomo",
    "mihomo.exe",
    "mihomo-party.exe",
    "v2ray.exe",
    "v2rayn.exe",
    "xray.exe",
    "sing-box.exe",
    "shadowsocks.exe",
    "shadowsocks-win.exe",
    "shadowsocksr.exe",
    "hiddify.exe",
    "hiddify-next.exe",
    "nekoray.exe",
    "nekobox.exe",
    "qv2ray.exe",
    "trojan.exe",
    "trojan-go.exe",
    "wireguard.exe",
    "warp-svc.exe",
    "cloudflare warp.exe",
    "tailscale.exe",
    "tailscaled.exe"
  ],
  "clash_proxy_ports": [
    1080,
    2080,
    7890,
    7891,
    7892,
    7893,
    7897,
    8080,
    10808,
    10809,
    20170
  ],
  "claude_route_checks_enabled": true,
  "providers": [
    "https://ip.api.skk.moe/v1/ipinfo-simple",
    "https://ipwho.is/",
    "https://ipapi.co/json/",
    "https://claude.ai/cdn-cgi/trace",
    "https://api.anthropic.com/cdn-cgi/trace"
  ],
  "geo_providers": [
    "https://ip.net.coffee/api/geoip/{ip}"
  ]
}
